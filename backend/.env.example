NODE_ENV=development
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173
# Set only when the completed React build is ready to serve from this API.
# FRONTEND_DIST_PATH=../frontend/dist
JWT_SECRET=replace_with_a_long_random_secret_generated_locally
JWT_EXPIRES_IN=1h
JWT_ISSUER=hustlehub-plus
JWT_AUDIENCE=hustlehub-plus-api
TLS_KEY_PATH=certs/localhost-key.pem
TLS_CERT_PATH=certs/localhost-cert.pem
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub
