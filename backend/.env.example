NODE_ENV=development
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173
# Set only when the completed React build is ready to serve from this API.
# FRONTEND_DIST_PATH=../frontend/dist
JWT_SECRET=replace_with_a_long_random_secret_generated_locally
JWT_EXPIRES_IN=1h
JWT_ISSUER=hustlehub-plus
JWT_AUDIENCE=hustlehub-plus-api
TLS_KEY_PATH=certs/localhost-key.pem
TLS_CERT_PATH=certs/localhost-cert.pem
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub

# Optional: ship structured log events to a cloud log platform (free tier).
# Leave both unset to log to the console only.
# Axiom example: LOG_SHIP_URL=https://api.axiom.co/v1/ingest/hustlehub-logs
# (use the domain shown in your Axiom settings) and LOG_SHIP_TOKEN=<API token with ingest permission>
LOG_SHIP_URL=
LOG_SHIP_TOKEN=
