      "key": "freelancerToken",
      "value": ""
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "otherClientToken",
      "value": ""
    },
    {
      "key": "gigId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
