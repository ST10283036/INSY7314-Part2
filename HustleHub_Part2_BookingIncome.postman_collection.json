        {
          "name": "Create Booking - Client Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking has expected fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.booking.gig).to.eql(pm.collectionVariables.get('gigId'));",
                  "    pm.expect(jsonData.booking.price).to.eql(500);",
                  "    pm.expect(jsonData.booking.status).to.eql('confirmed');",
                  "    pm.collectionVariables.set('bookingId', jsonData.booking.id);",
                  "});",
                  "pm.test('Transaction was created', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.transaction.amount).to.eql(500);",
                  "    pm.expect(jsonData.transaction.status).to.eql('completed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
