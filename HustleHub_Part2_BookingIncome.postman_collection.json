          "name": "Get Income - Freelancer Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Income reflects the completed booking', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalIncome).to.be.at.least(500);",
                  "    pm.expect(jsonData.transactionCount).to.be.at.least(1);",
                  "    pm.expect(jsonData.recentTransactions).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
