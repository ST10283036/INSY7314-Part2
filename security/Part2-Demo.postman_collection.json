          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var count = Number(pm.variables.get('12 Login rate limitCount') || '0') + 1;",
              "pm.variables.set('12 Login rate limitCount', String(count));",
              "pm.test('Controlled quota response', function () { pm.expect([401,429]).to.include(pm.response.code); });",
              "if (pm.response.code === 429) {",
              "  pm.test('Retry information', function () { pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0); });",
              "} else if (count < 22) { pm.execution.setNextRequest('12 Login rate limit'); }",
              "else { pm.test('Rate limit reached', function () { pm.expect(pm.response.code).to.equal(429); }); }"
            ]
          }
        }
