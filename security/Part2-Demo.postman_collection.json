            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"03 Cross-owner gig edit denied\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
