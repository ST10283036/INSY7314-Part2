{
  "info": {
    "name": "HustleHub Part 2 - Security Evidence Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import the private local demo environment first. Use a disposable local development database. Run the collection to execute quota checks."
  },
  "item": [
    {
      "name": "01 Security headers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01 Security headers\", function () { pm.response.to.have.status(200); });",
              "pm.test('CSP is restrictive', function () { pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"script-src 'self'\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Client denied gig creation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{clientAToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/gigs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden listing\",\n  \"description\": \"This listing must not be created.\",\n  \"price\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"02 Client denied gig creation\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Cross-owner gig edit denied",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{freelancerBToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/gigs/{{gigId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unauthorised change\"\n}",
          "options": {
            "raw": {
