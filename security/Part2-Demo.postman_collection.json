    {
      "name": "10 HTML sanitised before storage",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{freelancerAToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/gigs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"<script>alert(1)</script><b>Safe title</b>\",\n  \"description\": \"Ordinary description for a local service.\",\n  \"price\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"10 HTML sanitised before storage\", function () { pm.response.to.have.status(201); });",
              "pm.test('HTML removed', function () { pm.expect(pm.response.json().gig.title).to.equal('Safe title'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Booking rate limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{clientAToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gigId\": \"000000000000000000000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('11 Booking rate limitCount')) pm.variables.set('11 Booking rate limitCount', '0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var count = Number(pm.variables.get('11 Booking rate limitCount') || '0') + 1;",
              "pm.variables.set('11 Booking rate limitCount', String(count));",
              "pm.test('Controlled quota response', function () { pm.expect([404,429]).to.include(pm.response.code); });",
              "if (pm.response.code === 429) {",
              "  pm.test('Retry information', function () { pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0); });",
              "} else if (count < 22) { pm.execution.setNextRequest('11 Booking rate limit'); }",
              "else { pm.test('Rate limit reached', function () { pm.expect(pm.response.code).to.equal(429); }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Login rate limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"absent_rate_demo\",\n  \"password\": \"IncorrectDemo1!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('12 Login rate limitCount')) pm.variables.set('12 Login rate limitCount', '0');"
            ]
