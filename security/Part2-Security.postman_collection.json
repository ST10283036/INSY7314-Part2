    {
      "name": "Login throttling",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"absent_rate_user\",\n  \"password\": \"IncorrectDemo1!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var attempts = Number(pm.collectionVariables.get('rateAttempts') || '0') + 1;",
              "pm.collectionVariables.set('rateAttempts', String(attempts));",
              "pm.test('Controlled login response', function () { pm.expect([401,429]).to.include(pm.response.code); });",
              "if (pm.response.code === 429) {",
              "  pm.test('Retry information supplied', function () { pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0); });",
              "  pm.execution.setNextRequest(null);",
              "} else if (attempts < 12) { pm.execution.setNextRequest('Login throttling'); }",
              "else { pm.test('Rate limit reached', function () { pm.expect(pm.response.code).to.equal(429); }); }"
            ]
          }
        }
      ]
    }
