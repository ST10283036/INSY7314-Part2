{
  "info": {
    "name": "HustleHub Part 2 - Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Role, ownership, JWT, validation, headers and rate-limiting regression tests. Use a dedicated local test database."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "01 Health and security headers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01 Health and security headers\", function () { pm.response.to.have.status(200); });",
              "pm.test('Restrictive CSP', function () { pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"script-src 'self'\"); });",
              "pm.test('MIME sniffing blocked', function () { pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register clientA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{clientA}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var suffix = pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, '').slice(0, 8);",
              "pm.collectionVariables.set('demoPassword', pm.variables.replaceIn('{{$randomUUID}}') + 'aA1!');",
              "['clientA','clientB','freelancerA','freelancerB'].forEach(function (name) { pm.collectionVariables.set(name, name.toLowerCase() + '_' + suffix); });",
              "pm.collectionVariables.set('rateAttempts', '0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Register clientA\", function () { pm.response.to.have.status(201); });",
              "pm.test('No password leakage', function () { pm.expect(pm.response.json().user).not.to.have.property('passwordHash'); });"
            ]
          }
        }
      ]
    },
