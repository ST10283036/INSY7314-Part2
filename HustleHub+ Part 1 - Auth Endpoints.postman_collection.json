{
  "info": {
    "_postman_id": "ee52ca9b-c7cc-4191-8a82-ef2a8002982b",
    "name": "HustleHub+ Part 1 - Auth Endpoints",
    "description": "Tests for user registration, login, and the protected route. Base URL uses HTTPS with a self-signed local certificate — SSL certificate verification must be OFF in Postman settings for these requests to succeed locally.\n\nLogin - Success automatically captures the returned JWT into the {{token}} collection variable, which the Protected Route requests then use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56822746",
    "_collection_link": "https://go.postman.co/collection/56822746-ee52ca9b-c7cc-4191-8a82-ef2a8002982b?source=collection_link"
  },
  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "Register - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains user id, username, and role', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user).to.have.property('id');",
                  "    pm.expect(jsonData.user.username).to.eql('testuser1');",
                  "    pm.expect(jsonData.user.role).to.eql('client');",
                  "});",
                  "pm.test('Password/hash is not returned in response', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user.password).to.be.undefined;",
                  "    pm.expect(jsonData.user.passwordHash).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"TestPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register - Missing Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Validation failed message present', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Validation failed.');",
                  "});",
                  "pm.test('Errors array present', function () {",
                  "    pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
