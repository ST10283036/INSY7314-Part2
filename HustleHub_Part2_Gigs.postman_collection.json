{
  "info": {
    "name": "HustleHub+ Part 2 - Gigs Endpoints",
    "description": "Tests for gig CRUD endpoints, including RBAC enforcement (client vs freelancer). Base URL uses HTTPS with a self-signed local certificate \u2014 SSL certificate verification must be OFF in Postman settings for these requests to succeed locally.\n\nRun order matters: Register/Login requests capture tokens into collection variables that later requests depend on. Use the Collection Runner to execute the whole collection in order, or run folders top to bottom manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5000"
    },
    {
      "key": "freelancerToken",
      "value": ""
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "gigId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup - Register & Login",
      "item": [
        {
          "name": "Register Freelancer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 or 409 (already exists)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pmFreelancer1\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"freelancer\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Register Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 or 409 (already exists)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pmClient1\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"client\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login Freelancer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Role is freelancer', function () {",
                  "    pm.expect(pm.response.json().user.role).to.eql('freelancer');",
                  "});",
                  "pm.collectionVariables.set('freelancerToken', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pmFreelancer1\",\n  \"password\": \"TestPass123!\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Role is client', function () {",
                  "    pm.expect(pm.response.json().user.role).to.eql('client');",
                  "});",
                  "pm.collectionVariables.set('clientToken', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pmClient1\",\n  \"password\": \"TestPass123!\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gigs",
      "item": [
        {
          "name": "Create Gig - Freelancer Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Gig has expected fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.gig.title).to.eql('Logo Design');",
                  "    pm.expect(jsonData.gig.price).to.eql(500);",
                  "    pm.expect(jsonData.gig.isAvailable).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('gigId', pm.response.json().gig.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gigs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gigs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Logo Design\",\n  \"description\": \"Professional logo design service\",\n  \"price\": 500\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create Gig - Client Forbidden (RBAC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Permission denied message', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('You do not have permission to perform this action.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gigs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gigs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Not Work\",\n  \"description\": \"Clients cannot create gigs\",\n  \"price\": 100\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create Gig - No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gigs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gigs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Not Work\",\n  \"description\": \"No auth provided\",\n  \"price\": 100\n}"
            }
          },
          "response": []
        },
        {
          "name": "List Available Gigs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns an array of gigs', function () {",
                  "    pm.expect(pm.response.json().gigs).to.be.an('array');",
                  "});",
                  "pm.test('Created gig appears in listing', function () {",
                  "    const gigs = pm.response.json().gigs;",
                  "    const found = gigs.some((g) => g.id === pm.collectionVariables.get('gigId'));",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gigs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gigs"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List My Gigs - Freelancer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns at least one gig', function () {",
                  "    pm.expect(pm.response.json().gigs.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gigs/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gigs",
                "mine"
              ]
            }
          },
          "response": []
        },
