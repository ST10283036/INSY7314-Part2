            "url": {
              "raw": "{{baseUrl}}/api/gigs/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gigs",
                "mine"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Gig By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
