        {
          "name": "Update Gig - Freelancer Owner Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Price was updated', function () {",
                  "    pm.expect(pm.response.json().gig.price).to.eql(650);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
